#-------------------------
# Operating Specific Junk Files
#-------------------------

# OS X
.DS_Store
.AppleDouble
.LSOverride

# OS X Thumbnails
._*

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Linux
*~

# KDE directory preferences
.directory

# Linux trash folder
.Trash-*

#-------------------------
# Environment Files
#-------------------------

# Never commit environment variables or secrets.
.env
.env.*
!.env.example

.vagrant
Vagrantfile

#-------------------------
# CodeIgniter Writable Files
#-------------------------

/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

php_errors.log

#-------------------------
# Public User Uploads
#-------------------------

# Ignore uploaded avatars but preserve the directory.
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep

# Ignore the unused uploads placeholder.
/public/uploads/placeholder.svg

#-------------------------
# User Guide Temporary Files
#-------------------------

/user_guide_src/build/*
/user_guide_src/cilexer/build/*
/user_guide_src/cilexer/dist/*
/user_guide_src/cilexer/pycilexer.egg-info/*

#-------------------------
# Test Files
#-------------------------

/tests/coverage*

# Do not commit PHPUnit installation.
/phpunit
/results/
/phpunit.xml

#-------------------------
# Composer
#-------------------------

vendor/

#-------------------------
# IDE and Development Files
#-------------------------

# Modules testing
_modules/*

# phpenv local configuration
.php-version

# JetBrains editors
.idea/
*.iml

# NetBeans
/nbproject/
/build/
/nbbuild/
/dist/
/nbdist/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# PHP development tools
.phpintel
/api/

# Visual Studio Code
.vscode/